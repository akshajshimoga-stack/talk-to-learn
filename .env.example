# Database Configuration
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/talk-to-learn
# For Local MongoDB: mongodb://localhost:27017/talk-to-learn
MONGODB_URI=mongodb://localhost:27017/talk-to-learn

# JWT Secret (Change this in production!)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-change-in-production

# Server Configuration
PORT=3000
NODE_ENV=development

# Ping Message (Optional - for testing)
PING_MESSAGE=pong

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4-turbo

# Text-to-Speech Configuration
# Using ElevenLabs or similar service
TTS_API_KEY=your-tts-api-key
TTS_VOICE_ID_MALE=your-male-voice-id
TTS_VOICE_ID_FEMALE=your-female-voice-id

# File Storage Configuration
# Can be: local, s3, gcs
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# AWS S3 Configuration (if using S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=talk-to-learn-pdfs

# Frontend Configuration
VITE_API_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=noreply@talk-to-learn.com
